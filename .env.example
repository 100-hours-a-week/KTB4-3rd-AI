# luna(OpenAI) 키. _1과 _2는 서로 다른 키다.
# _1: 이미지(영수증, 택시미터). 없으면 예전 이름 OPENAI_API_KEY를 읽는다.
OPENAI_API_KEY_1=
# _2: 혼잡도. 혼잡도 담당이 채운다.
OPENAI_API_KEY_2=

# 이 서버에서 OCR과 openjev를 직접 돌릴지. TRUE | FALSE (기본 FALSE)
# FALSE이고 Modal _1 키도 없으면 항상 luna만 쓴다(v2).
LOCAL_DEVICE=FALSE

# Modal T4 토큰(v3). _1과 _2는 서로 다른 Modal 계정이다.
# _1: 이미지. 둘 다 있으면 LOCAL_DEVICE보다 먼저 Modal을 쓴다.
MODAL_TOKEN_ID_1=
MODAL_TOKEN_SECRET_1=
# _2: 혼잡도. 혼잡도 담당이 채운다.
MODAL_TOKEN_ID_2=
MODAL_TOKEN_SECRET_2=
