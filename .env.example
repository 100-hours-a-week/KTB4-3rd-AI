APP_NAME=KTB4 AI API
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1

# Congestion analysis policy defaults from the AI wiki.
CONGESTION_WINDOW_MINUTES=20
CONGESTION_CACHE_TTL_MINUTES=25
CONGESTION_MODEL_CONCURRENCY=1

# The concrete congestion model/provider will be selected during implementation.
CONGESTION_MODEL_PROVIDER=
CONGESTION_MODEL_NAME=
OPENAI_API_KEY=
