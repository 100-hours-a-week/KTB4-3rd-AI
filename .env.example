# luna(OpenAI). v2, v3 모두 필요하다.
OPENAI_API_KEY=

# 혼잡도 관련성 평가 후 값을 지정한다. 기본값은 없으며 모의 테스트의 수치는 운영값이 아니다.
CONGESTION_RELEVANCE_EXCLUDE_BELOW=
CONGESTION_RELEVANCE_RELATED_AT_OR_ABOVE=
# Decisions의 연결·읽기 등 동작별 제한(초). 전체 요청 마감은 별도 합의가 필요하다.
CONGESTION_DECISIONS_TIMEOUT_SECONDS=

# off | mps | cpu | cuda | modal
# off는 v2로 luna만 쓴다. mps는 이 맥에서 OCR과 openjev를 돌린다.
# 비우면 MODAL_TOKEN_ID가 있을 때 modal(v3), 없으면 off다.
IMAGE_DEVICE=off

# v3. Modal T4를 부를 때 쓴다.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
