# OPENAI API키
# _1: 이미지(영수증, 택시미터) API키
OPENAI_API_KEY_1=
# _2: 혼잡도 API키
OPENAI_API_KEY_2=

# 로컬 테스트용 -> FALSE 유지
LOCAL_DEVICE=FALSE

# 메트릭 OTLP push (기본 꺼짐). 켜면 OTLP_METRICS_URL 주소로 30초마다 보내고, 종료 때 한 번 더 보낸다.
OTLP_METRICS_ENABLED=false
# 예: http://<모니터링 호스트>:4318/v1/metrics (전체 경로를 넣는다)
OTLP_METRICS_URL=
OTLP_SERVICE_NAME=fastapi
OTLP_SERVICE_NAMESPACE=

# Modal 토큰
# _1: 이미지(영수증, 택시미터) MODAL 토큰 
MODAL_TOKEN_ID_1=
MODAL_TOKEN_SECRET_1=
# _2: 혼잡도 MODAL 토큰
MODAL_TOKEN_ID_2=
MODAL_TOKEN_SECRET_2=
