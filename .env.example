# OPENAI API키
# _1: 이미지(영수증, 택시미터) API키
OPENAI_API_KEY_1=
# _2: 혼잡도 API키
OPENAI_API_KEY_2=

# 혼잡도 관련성 평가 후 값을 지정한다. 기본값은 없으며 모의 테스트의 수치는 운영값이 아니다.
CONGESTION_RELEVANCE_EXCLUDE_BELOW=
CONGESTION_RELEVANCE_RELATED_AT_OR_ABOVE=
# Decisions의 연결·읽기 등 동작별 제한(초). 전체 요청 마감은 별도 합의가 필요하다.
CONGESTION_DECISIONS_TIMEOUT_SECONDS=

# 로컬 테스트용 -> FALSE 유지
LOCAL_DEVICE=FALSE

# Modal 토큰
# _1: 이미지(영수증, 택시미터) MODAL 토큰
MODAL_TOKEN_ID_1=
MODAL_TOKEN_SECRET_1=
# _2: 혼잡도 MODAL 토큰
MODAL_TOKEN_ID_2=
MODAL_TOKEN_SECRET_2=
