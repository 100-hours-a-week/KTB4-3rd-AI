# OPENAI API키
# _1: 이미지(영수증, 택시미터) API키
OPENAI_API_KEY_1=
# _2: 혼잡도 API키
OPENAI_API_KEY_2=

# 로컬 테스트용 -> FALSE 유지
LOCAL_DEVICE=FALSE

# Modal 토큰
# _1: 이미지(영수증, 택시미터) MODAL 토큰
MODAL_TOKEN_ID_1=
MODAL_TOKEN_SECRET_1=
# _2: 혼잡도 MODAL 토큰
MODAL_TOKEN_ID_2=
MODAL_TOKEN_SECRET_2=

# 서버 모니터링 봇 — 필수(값: 클라우드팀). 비우면 모니터만 꺼지고 서비스는 그대로 뜬다
# AI_DB_URL: mysql://<계정>:<비밀번호>@<호스트>:3306/ai_<local|dev|stg|prod>?ssl=<verify|required>  (DB 이름으로 스테이지를 정한다)
AI_DB_URL=
# Qdrant 주소와 읽기·쓰기 키
AI_QDRANT_URL=
AI_QDRANT_API_KEY=

# 서버 모니터링 봇 — 텔레그램(값: AI 담당자). 같은 토큰은 한 시점에 한 스테이지에서만 쓴다
TELEGRAM_BOT_TOKEN=
# 관리자 텔레그램 사용자 id(숫자, 여러 명이면 쉼표. 민감 정보 아님)
Admin_Telegram_ID=

# 서버 모니터링 봇 — 디스코드(값: AI 담당자). 토큰을 비우면 디스코드는 꺼지고 텔레그램만 쓴다
DISCORD_BOT_TOKEN=
# 알림을 보내고 메시지를 받을 채널 id(민감 정보 아님)
DISCORD_CHANNEL_ID=
# 관리자 디스코드 사용자 id(숫자, 여러 명이면 쉼표. 민감 정보 아님)
Admin_Discord_ID=

# 서버 모니터링 봇 — 선택(값: AI 담당자). 비워도 동작한다
# 모니터 전용 OpenAI 키. 비우면 OPENAI_API_KEY_1을 쓴다
OPENAI_API_KEY_MONITOR=
# 장애 훈련 합성 요청에 쓸 이미지 URL(dev·local만, 개인정보 없는 테스트 이미지)
DRILL_IMAGE_URL=
# 모니터 버퍼·로그 폴더. 비우면 /tmp/server_bot
SERVER_BOT_DIR=
