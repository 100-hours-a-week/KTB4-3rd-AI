# luna(OpenAI). v2, v3 모두 필요하다. 모델을 비우면 gpt-6-luna를 쓴다.
# _1: 이미지(영수증, 택시미터)
OPENAI_API_KEY_1=
OPENAI_MODEL_1=
# _2: 혼잡도
OPENAI_API_KEY_2=
OPENAI_MODEL_2=

# off | mps | cpu | cuda | modal
# off는 v2로 luna만 쓴다. mps는 이 맥에서 OCR과 openjev를 돌린다.
# 비우면 MODAL_TOKEN_ID가 있을 때 modal(v3), 없으면 off다.
IMAGE_DEVICE=off

# v3. Modal T4를 부를 때 쓴다.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
