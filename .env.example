# OPENAI API키
# _1: 이미지(영수증, 택시미터) API키
OPENAI_API_KEY_1=
# _2: 혼잡도 API키
OPENAI_API_KEY_2=

# 혼잡도 폴백 API 키 - haiku(Anthropic) 폴백 모델
ANTHROPIC_API_KEY=

# 로컬 테스트용 -> FALSE 유지
LOCAL_DEVICE=FALSE

# Modal 토큰
# _1: 이미지(영수증, 택시미터) MODAL 토큰
MODAL_TOKEN_ID_1=
MODAL_TOKEN_SECRET_1=
# _2: 혼잡도 MODAL 토큰
MODAL_TOKEN_ID_2=
MODAL_TOKEN_SECRET_2=

# Kafka. 비어 있으면 consumer를 띄우지 않는다(HTTP만 동작)
KAFKA_BOOTSTRAP_SERVERS=
# PLAINTEXT 또는 SSL
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# 혼잡도 consumer. 분석 한 건 제한 시간, 이보다 오래된 구간은 분석하지 않고 실패 결과, 한 번에 받는 메시지 수
CONGESTION_ANALYSIS_TIMEOUT_SECONDS=240
CONGESTION_STALE_AFTER_MINUTES=60
CONGESTION_MAX_IN_FLIGHT=10
